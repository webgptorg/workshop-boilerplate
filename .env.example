# Supabase public project settings, embedded into the browser bundle at build time.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are also accepted for existing setups.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL credentials for startup migrations. Never use NEXT_PUBLIC_.
# Use the direct connection or session pooler on port 5432 from Supabase's Connect dialog.
# URL-encode the database password. Do not add sslmode or other SSL URL parameters.
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres
# Optional PEM CA certificate, using literal \n separators if needed. TLS is always verified remotely.
SUPABASE_DATABASE_CA=

# Development only: enable the seeded test@ptbk.io / password123 account on first migration.
# Production startup rejects true. Defaults to false; a seeded known password is banned.
ENABLE_TEST_ACCOUNT=false

# Server-only credentials. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
