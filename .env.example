# Server-only credentials. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Per-file local audio upload limits. Positive numbers; defaults shown below.
# Public settings are fixed at build time. Rebuild after changing them.
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_SIZE_MB=500
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_DURATION_HOURS=5

# Supabase project URL and publishable key. These two values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL URL: use a direct connection or session pooler.
# Copy the local URL from `npx supabase status`, or the hosted URL from Connect.
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted database CA certificate in PEM format, with \n escapes for newlines.
# Leave empty locally. Hosted connections always verify TLS, using the system CA
# when this is omitted. Never use rejectUnauthorized=false.
SUPABASE_DATABASE_CA=

# Development defaults to true; production defaults to false. This only controls
# the initial migration. Hosted production refuses the known default password.
# DB_SEED_TEST_USER=true
