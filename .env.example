# Server-only credentials. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Supabase Project URL and publishable key are safe for the browser. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server and CI only: use the Supabase Postgres connection string.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_DATABASE_URL=
