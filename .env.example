# Supabase Project Settings > API. A publishable key (or legacy anon key) is safe here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only migration connection. Use the direct or session-pooler PostgreSQL URL.
# Percent-encode the password; omit sslmode/sslcert/sslkey/sslrootcert parameters.
SUPABASE_DATABASE_URL=
# Project CA certificate in PEM form, with literal \n between lines if needed.
# Remote connections always verify TLS. Localhost connections use no TLS.
SUPABASE_DATABASE_CA=

# Server-only credentials. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
